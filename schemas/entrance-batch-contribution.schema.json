{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.gapwise.ca/schemas/entrance-batch-contribution.schema.json",
  "title": "Gapwise batch entrance contribution",
  "type": "object",
  "required": ["schemaVersion", "contributionType", "entrances", "submittedVia", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contributionType": { "const": "new_entrance_batch" },
    "entrances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["buildingCode", "buildingName", "geometry", "entranceKind", "claims", "evidence"],
        "properties": {
          "buildingCode": { "type": "string", "minLength": 1 },
          "buildingName": { "type": "string", "minLength": 1 },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "prefixItems": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90, "maximum": 90 }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "additionalProperties": false
          },
          "proposedLabel": { "type": ["string", "null"] },
          "entranceKind": { "const": "exterior_entrance" },
          "claims": {
            "type": "object",
            "required": ["publicAccess", "direction", "barrierFree"],
            "properties": {
              "publicAccess": { "enum": ["verified", "restricted", "unknown"] },
              "direction": { "enum": ["bidirectional", "entry_only", "exit_only", "unknown"] },
              "barrierFree": { "enum": ["verified", "not_barrier_free", "unknown"] }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "required": ["method", "observedAt"],
            "properties": {
              "method": { "enum": ["field_observation", "official_source", "other"] },
              "observedAt": { "type": "string", "format": "date" }
            },
            "additionalProperties": false
          },
          "contributorNotes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "submittedVia": { "type": "string", "format": "uri" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
