{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.gapwise.ca/schemas/entrance-contribution.schema.json",
  "title": "Gapwise Data entrance contribution",
  "type": "object",
  "required": [
    "schemaVersion",
    "contributionType",
    "buildingCode",
    "buildingName",
    "geometry",
    "entranceKind",
    "observedAt",
    "observationMethod",
    "claims",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contributionType": {
      "enum": ["new_entrance", "existing_entrance_update"]
    },
    "buildingCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,8}$"
    },
    "buildingName": { "type": "string", "minLength": 1 },
    "existingEntranceId": { "type": "string", "minLength": 1 },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "proposedLabel": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "entranceKind": {
      "enum": ["exterior_entrance", "building_connection"]
    },
    "observedAt": { "type": "string", "format": "date" },
    "observationMethod": {
      "enum": ["field_observation", "source"]
    },
    "claims": {
      "type": "object",
      "required": ["publicAccess", "direction", "barrierFree"],
      "properties": {
        "publicAccess": {
          "enum": ["verified", "restricted", "unknown"]
        },
        "direction": {
          "enum": ["bidirectional", "entry_only", "exit_only", "unknown"]
        },
        "barrierFree": {
          "enum": ["verified", "not_barrier_free", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri" },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "contributionType": { "const": "existing_entrance_update" } }
      },
      "then": { "required": ["existingEntranceId"] }
    },
    {
      "if": {
        "properties": { "observationMethod": { "const": "source" } }
      },
      "then": {
        "properties": {
          "evidence": { "required": ["sourceUrl"] }
        }
      }
    }
  ],
  "additionalProperties": false
}
