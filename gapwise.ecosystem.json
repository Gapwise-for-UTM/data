{
  "schemaVersion": 1,
  "self": "data",
  "githubOrganization": "Gapwise-for-UofT",
  "canonical": {
    "app": "https://gapwise.ca",
    "api": "https://api.gapwise.ca/v1",
    "openapi": "https://api.gapwise.ca/openapi.json",
    "docs": "https://docs.gapwise.ca",
    "data": "https://data.gapwise.ca",
    "ai": "https://ai.gapwise.ca",
    "mcp": "https://ai.gapwise.ca/api/mcp",
    "status": "https://status.gapwise.ca"
  },
  "repositories": {
    "core": "https://github.com/Gapwise-for-UofT/gapwise",
    "android": "https://github.com/Gapwise-for-UofT/android",
    "ios": "https://github.com/Gapwise-for-UofT/ios",
    "ai": "https://github.com/Gapwise-for-UofT/ai",
    "data": "https://github.com/Gapwise-for-UofT/data",
    "docs": "https://github.com/Gapwise-for-UofT/docs",
    "status": "https://github.com/Gapwise-for-UofT/status"
  },
  "ownership": {
    "core": [
      "student-state",
      "deterministic-domain-logic",
      "routing-algorithms",
      "gap-planning",
      "map-product-ui",
      "public-api",
      "openapi",
      "typescript-sdk",
      "python-sdk"
    ],
    "android": ["native-android-ux", "android-device-integration", "android-distribution"],
    "ios": ["native-ios-ux", "ios-device-integration", "ios-distribution"],
    "ai": ["oauth", "mcp", "delegation", "bounded-ai-actions"],
    "data": [
      "canonical-public-campus-facts",
      "campus-geometry",
      "entrances",
      "routing-graph-data",
      "provenance",
      "schemas",
      "evidence",
      "attribution",
      "validation",
      "reuse"
    ],
    "docs": ["released-developer-documentation"],
    "status": ["service-health", "incident-communication"]
  },
  "campusData": {
    "canonicalRepository": "https://github.com/Gapwise-for-UofT/data",
    "canonicalPath": "data/utm",
    "coreMirrorPath": "src/data/utm",
    "runtimeFetchRequired": false,
    "syncMode": "vendored-build-time-snapshot"
  },
  "sdks": {
    "typescript": {
      "package": "@gapwise/sdk",
      "registries": {
        "npm": { "version": "0.1.1", "state": "published", "role": "canonical" },
        "jsr": { "version": "0.1.1", "state": "published", "role": "canonical" },
        "githubPackages": { "package": "@gapwise-for-uoft/sdk", "version": "0.1.1", "state": "published", "role": "mirror" }
      },
      "runtimeTargets": ["node", "bun", "deno", "browser"],
      "model": "single-portable-implementation"
    },
    "python": {
      "package": "gapwise",
      "registries": {
        "pypi": { "version": "0.1.0", "state": "published", "role": "canonical" },
        "githubReleases": { "version": "0.1.0", "tag": "python-v0.1.0", "state": "published", "role": "mirror" }
      },
      "clients": ["sync", "async"]
    }
  },
  "contract": {
    "publicApiVersion": "v1",
    "sourceOfTruth": "openapi-and-core-implementation",
    "sdkParityRequired": true,
    "privateStudentDataInPublicApi": false
  }
}
